# ============================================================
# ATELIER GROUPE — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ---- Vendure Backend ----------------------------------------
# The Vendure shop GraphQL API endpoint
NEXT_PUBLIC_VENDURE_SHOP_API_URL=http://localhost:3000/shop-api

# Vendure channel token (found in Admin → Channels)
VENDURE_CHANNEL_TOKEN=your-channel-token

# Vendure admin API (server-side only, never expose to client)
VENDURE_ADMIN_API_URL=http://localhost:3000/admin-api
VENDURE_ADMIN_API_TOKEN=your-admin-api-token

# ---- Stripe -------------------------------------------------
# Publishable key — safe to expose to client
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key — NEVER expose to client
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret (from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Redis --------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Session ------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-secret-of-at-least-32-chars
# Session TTL in seconds (default: 30 days)
SESSION_TTL=2592000

# ---- Application --------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_NAME=ATELIER GROUPE

# ---- Docker / Vendure Database (local dev reference) --------
POSTGRES_DB=vendure
POSTGRES_USER=vendure
POSTGRES_PASSWORD=vendure_dev_password_change_in_prod

# ---- CMS (optional — for editorial content) -----------------
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# SANITY_API_TOKEN=

# ---- Analytics (optional) -----------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
